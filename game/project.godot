; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters here are not all obvious.

config_version=5

[application]

config/name="Prototipe"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ShipTelemetryGlobal="*uid://cxs7bhejye52s"
DeathScreen="*res://ui/death_screen.tscn"
MissionCompleteScreen="*res://ui/mission_complete_screen.tscn"
Localization="*res://scripts/localization.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

